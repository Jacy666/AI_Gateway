# Server Configuration
SERVER_PORT=8080
GIN_MODE=debug

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRE_HOURS=24

# gRPC Configuration
GRPC_MODEL_SERVICE=localhost:50051
GRPC_TIMEOUT_SECONDS=60

# Rate Limiting Configuration (Token Bucket Algorithm)
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# Worker Pool Configuration
NUM_WORKERS=10
TASK_BUFFER_SIZE=1000
